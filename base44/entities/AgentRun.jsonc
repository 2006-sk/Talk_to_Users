{
  "name": "AgentRun",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "invoice_id": {
      "type": "string"
    },
    "agent": {
      "type": "string",
      "enum": [
        "intake",
        "ledger",
        "web_verifier",
        "identity_matcher",
        "price_checker",
        "risk_judge",
        "call_agent",
        "router"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "done",
        "error",
        "skipped"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "ok",
        "warn",
        "fail",
        "info"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string"
    },
    "output": {
      "type": "object"
    },
    "confidence": {
      "type": "number"
    },
    "model_used": {
      "type": "string"
    }
  },
  "required": [
    "invoice_id",
    "agent"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "data.company_id": "demo"
        }
      ]
    },
    "create": false,
    "update": false,
    "delete": false
  }
}